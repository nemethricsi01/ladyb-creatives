---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import aboutPhoto from '../assets/about.jpg';
import bioPhoto from '../assets/playground/wall_poster6.jpg';

const base = '/';
---

<BaseLayout title="About" description="About Turcsik Bella — Budapest-based graphic designer specializing in brand identity, packaging, editorial and illustration.">

  <div class="page-wrap">

    <!-- Hero -->
    <section class="about-hero">
      <div class="container ah-inner">
        <div class="ah-text">
          <span class="label">About</span>
          <h1 class="ah-title">Turcsik<br /><em>Bella</em></h1>
          <p class="ah-role">Graphic Designer — Budapest</p>
        </div>
        <div class="ah-visual">
          <div class="photo-frame">
            <Image src={aboutPhoto} alt="Turcsik Bella" class="pf-photo" width={760} height={1013} />
          </div>
          <div class="pf-accent" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <!-- Bio -->
    <section class="section bio-section reveal">
      <div class="container bio-inner">
        <div class="bio-aside">
          <div class="bio-geo">
            <Image src={bioPhoto} alt="Wall poster detail" class="bg-photo" width={520} height={520} />
            <div class="bg-circle" aria-hidden="true"></div>
          </div>
        </div>
        <div class="bio-body">
          <span class="label" style="margin-bottom:1.5rem">Background</span>
          <p class="bio-lead">
            I'm a multidisciplinary graphic designer based in Budapest, transforming ideas into visual identities that combine aesthetics with purpose.
          </p>
          <p>
            My work focuses on branding, packaging, editorial layouts, and digital design — always balancing creativity with functionality.
          </p>
          <p>
            I believe design should communicate before it decorates. It should be clear, intentional, and timeless.
          </p>
          <p>
            When I'm not designing, you can find me exploring art, photography, and everything that inspires new ideas.
          </p>

          <div class="bio-details">
            <div class="bd-item">
              <span class="label">Based in</span>
              <p>Budapest, Hungary</p>
            </div>
            <div class="bd-item">
              <span class="label">Speciality</span>
              <p>Brand Identity</p>
              <p>Packaging</p>
              <p>Editorial</p>
              <p>Marketing</p>
              <p>Illustration</p>
            </div>
            <div class="bd-item">
              <span class="label">Available</span>
              <p>Freelance</p>
              <p>Remote</p>
              <p>Worldwide</p>
            </div>
          </div>

          <a href={`${base}contact`} class="btn btn-primary" style="margin-top:2.5rem">Work Together</a>
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section class="section experience-section reveal">
      <div class="container">
        <span class="label" style="margin-bottom:3rem;display:block">Selected Experience</span>
        <div class="experience-grid">
          {[
            ['2022', 'European Media Group Kft.', 'Graphic Designer'],
            ['2023', 'Mini Saigon Étterem', 'Content Creator & Graphic Designer'],
            ['2024', 'Amigo Group Budapest', 'Content Creator & Graphic Designer'],
            ['2024 —', 'Százszorszép Kozmetika', 'Marketing & Graphic Design'],
          ].map(([year, company, role]) => (
            <div class="exp-item">
              <span class="exp-year">{year}</span>
              <h3 class="exp-company">{company}</h3>
              <p class="exp-role">{role}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Process -->
    <section class="section process-section reveal">
      <div class="container">
        <span class="label" style="margin-bottom:3rem;display:block">How I Work</span>
        <div class="process-steps">
          {[
            ['01', 'Research & Discovery', 'Understanding the context: what the project is for, who it is for, and what it needs to say. Good design begins with good questions.'],
            ['02', 'Concept & Exploration', 'Sketching, colour exploration, typographic experiments. Finding the idea before executing it. The unexpected path is usually the right one.'],
            ['03', 'Refinement', 'Narrowing from many to one. Adjusting until the solution feels inevitable — not clever, not decorative, but exactly right.'],
            ['04', 'Delivery', 'Prepared files, brand guidelines, or print-ready artwork. Clear documentation so the work continues to function beyond our collaboration.'],
          ].map(([num, title, desc]) => (
            <div class="process-step">
              <span class="ps-num" aria-hidden="true">{num}</span>
              <div class="ps-body">
                <h3 class="ps-title">{title}</h3>
                <p class="ps-desc">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .page-wrap { padding-top: var(--nav-height); }

  /* ─── Hero ───────────────────────────────────────────────── */
  .about-hero {
    padding: 5rem 0 0;
    border-bottom: 1px solid var(--border);
  }

  .ah-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: flex-end;
  }

  .ah-text .label { margin-bottom: 1.5rem; }

  .ah-title {
    font-size: clamp(3.5rem, 8vw, 7rem);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }
  .ah-title em { color: var(--red); }

  .ah-role {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding-bottom: 3rem;
  }

  /* Photo frame — Magritte window motif */
  .ah-visual { position: relative; }

  .photo-frame {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--sky-dark);
    border: 3px solid var(--bg-dark);
  }

  .pf-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pf-accent {
    position: absolute;
    inset-block-start: 2rem;
    inset-inline-end: -1.5rem;
    width: 3rem;
    height: 60%;
    background: var(--pop-yellow);
    z-index: -1;
  }

  /* ─── Bio ────────────────────────────────────────────────── */
  .bio-inner {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 6rem;
    align-items: flex-start;
  }

  .bio-geo { position: relative; aspect-ratio: 1; }

  .bg-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bg-circle {
    position: absolute;
    inset-block-end: -10%;
    inset-inline-end: -10%;
    width: 65%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1.5px solid var(--earth);
  }

  .bio-body p {
    color: var(--text-muted);
    font-size: 0.95rem;
    max-width: 55ch;
    font-weight: 300;
    margin-bottom: 1.25rem;
  }

  .bio-lead {
    font-family: var(--font-serif);
    font-size: 1.35rem !important;
    font-weight: 300;
    color: var(--text) !important;
    line-height: 1.5;
  }

  .bio-details {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .bd-item .label { margin-bottom: 0.4rem; }

  .bd-item p {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--text);
    font-weight: 400;
    margin-bottom: 0.15rem !important;
  }
  .bd-item p:last-child { margin-bottom: 0 !important; }

  /* ─── Experience ─────────────────────────────────────────── */
  .experience-section { border-top: 1px solid var(--border); }

  .experience-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.5rem;
  }

  .exp-item {
    padding-inline-start: 1.5rem;
    border-inline-start: 2px solid var(--red);
  }

  .exp-year {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 0.75rem;
  }

  .exp-company {
    font-size: 1.15rem;
    font-weight: 400;
    line-height: 1.3;
    margin-bottom: 0.4rem;
  }

  .exp-role {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  /* ─── Process ────────────────────────────────────────────── */
  .process-steps {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .process-step {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 3rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--border);
    align-items: start;
  }

  .ps-num {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 300;
    color: var(--pop-yellow);
    line-height: 1;
    letter-spacing: -0.02em;
    -webkit-text-stroke: 1px var(--bg-dark);
  }

  .ps-title {
    font-size: 1.25rem;
    font-weight: 400;
    margin-bottom: 0.5rem;
  }

  .ps-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    font-weight: 300;
    max-width: 55ch;
    line-height: 1.65;
  }

  /* ─── Responsive ─────────────────────────────────────────── */
  @media (max-width: 960px) {
    .ah-inner    { grid-template-columns: 1fr; }
    .bio-inner   { grid-template-columns: 1fr; }
    .bio-geo     { display: none; }
    .bio-details { grid-template-columns: 1fr; gap: 1.5rem; }
    .experience-grid { grid-template-columns: 1fr 1fr; gap: 2rem 1.5rem; }
    .process-step    { grid-template-columns: 4rem 1fr; gap: 1.5rem; }
  }

  @media (max-width: 560px) {
    .experience-grid { grid-template-columns: 1fr; }
  }
</style>
