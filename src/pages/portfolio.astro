---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';

const base = '/';
---

<BaseLayout title="Work" description="Portfolio of Turcsik Bella — graphic design projects in visual identity, illustration, and print design.">

  <div class="page-wrap">

    <!-- Page Header -->
    <header class="page-header">
      <div class="container">
        <span class="label">Portfolio</span>
        <h1 class="page-title">Work</h1>
        <p class="page-desc">A summary of recent projects in visual identity, illustration, and print design.</p>
      </div>
    </header>

    <!-- Grid -->
    <section class="portfolio-section reveal">
      <div class="container">
        <div class="portfolio-grid">
          {projects.map((p) => (
            <a href={`${base}portfolio/${p.slug}`} class="project-card">
              <div class="card-img">
                <Image src={p.cover} alt={`${p.title} cover`} loading="lazy" width={600} />
                <div class="card-overlay">
                  <span class="overlay-services">{p.services.join(' · ')}</span>
                  <span class="overlay-title">{p.title}</span>
                  <span class="overlay-cta">View Project →</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

  </div>

</BaseLayout>

<style>
  .page-wrap { padding-top: var(--nav-height); }

  /* ─── Page Header ──────────────────────────────────────────── */
  .page-header {
    padding: 5rem 0 3rem;
    border-bottom: 1px solid var(--border);
  }

  .page-header .label { margin-bottom: 1rem; }

  .page-title {
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .page-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 300;
    max-width: 50ch;
  }

  /* ─── Portfolio Grid ───────────────────────────────────────── */
  .portfolio-section { padding: 4rem 0 7rem; }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
  }

  .project-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .card-img {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.18);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }

  .project-card:hover .card-img {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(0,0,0,0.24);
  }

  .card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }

  .project-card:hover .card-img img {
    transform: scale(1.06);
  }

  /* Hover overlay */
  .card-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.3rem;
    padding: 1.75rem;
    background: linear-gradient(to top, rgba(20,18,16,0.85) 0%, rgba(20,18,16,0.15) 55%, transparent 100%);
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }

  .project-card:hover .card-overlay { opacity: 1; }

  .overlay-services {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--pop-yellow);
  }

  .overlay-title {
    font-family: var(--font-serif);
    font-size: 1.7rem;
    font-weight: 400;
    color: #fff;
  }

  .overlay-cta {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cloud);
    margin-top: 0.35rem;
  }

  /* ─── Responsive ───────────────────────────────────────────── */
  @media (max-width: 768px) {
    .portfolio-grid { grid-template-columns: 1fr; gap: 2rem; }
    .card-overlay {
      opacity: 1;
      background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.72) 35%, rgba(0,0,0,0.25) 70%, transparent 100%);
    }
  }
</style>
