---
import BaseLayout from '../layouts/BaseLayout.astro';
import Playground from '../components/Playground.astro';
import { projects } from '../data/projects';

const base = '/';

const nameLine1 = 'BELLA'.split('');
const nameLine2 = 'TURCSIK'.split('');
const tileRotations = [-4, 3, -2, 4, -3, 2, -4];

const marqueeWords = ['Pop Art', 'Graphic Design', 'Illustration', 'Print', 'Budapest'];
---

<BaseLayout title="Home">

  <!-- ── Hero ──────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-overlay" aria-hidden="true"></div>

    <button type="button" id="pop-trigger" class="speech-bubble" aria-pressed="false" aria-label={'Toggle "pop" mode'}>
      <p id="pop-trigger-text">wdym <em>"just make it pop"</em>?</p>
    </button>

    <div class="hero-content">
      <span class="label hero-label-pop">Graphic Designer <span aria-hidden="true">|</span> Illustrator</span>

      <h1 class="ransom-name">
        <span class="ransom-word">
          {nameLine1.map((ch, i) => (
            <span class="tile" style={`--r:${tileRotations[i % tileRotations.length]}deg`}>{ch}</span>
          ))}
        </span>
        <span class="ransom-word">
          {nameLine2.map((ch, i) => (
            <span class="tile" style={`--r:${tileRotations[(i + 2) % tileRotations.length]}deg`}>
              {ch}
              {ch === 'C' && <span class="tile-copy" aria-hidden="true">©</span>}
            </span>
          ))}
        </span>
      </h1>

      <p class="hero-tagline-pop">
        I enjoy experimenting with different styles, techniques
        and mediums to create work that fits the idea.
      </p>

      <div class="hero-actions-pop">
        <a href={`${base}portfolio`} class="btn btn-pop-primary">Explore Projects →</a>
        <a href={`${base}about`} class="btn btn-pop-ghost">About Me</a>
      </div>
    </div>
  </section>

  <!-- ── Info Strip ────────────────────────────────────────────────── -->
  <section class="hero-strip">
    <div class="container strip-inner">
      <span>Branding · Packaging · Print · Illustration</span>
      <span>Based in Budapest · Available Worldwide</span>
    </div>
  </section>

  <!-- ── Latest Projects ───────────────────────────────────────────── -->
  <section class="section section-latest reveal">
    <div class="container">
      <div class="latest-header">
        <div>
          <h2 class="latest-title">
            Latest Projects
            <img src={`${base}logomark_ladyb2.svg`} alt="" class="latest-bee" aria-hidden="true" />
          </h2>
          <p class="latest-sub">A selection of recent projects</p>
        </div>
        <a href={`${base}portfolio`} class="link-arrow latest-all">View All Projects →</a>
      </div>

      <div class="latest-grid">
        {projects.map((p) => (
          <a href={`${base}portfolio/${p.slug}`} class="latest-card">
            <div class="latest-img-wrap">
              <img src={p.cover} alt={`${p.title} cover`} class="latest-img" loading="lazy" />
            </div>
            <div class="latest-meta">
              <span class="label latest-services">{p.services.join(' · ')}</span>
              <h3 class="latest-name">{p.title}</h3>
              <p class="latest-desc">{p.description[0]}</p>
              <span class="btn btn-primary latest-btn">View Project →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Marquee ───────────────────────────────────────────────────── -->
  <section class="marquee reveal" aria-hidden="true">
    <div class="marquee-track">
      {Array(8).fill(marqueeWords).flat().map((word) => (
        <>
          <span class="marquee-word">{word}</span>
          <span class="marquee-star">✦</span>
        </>
      ))}
    </div>
  </section>

  <!-- ── Creative Playground ───────────────────────────────────────── -->
  <Playground />

  <!-- ── Services Teaser ───────────────────────────────────────────── -->
  <section class="section section-services reveal">
    <div class="container">
      <div class="section-header">
        <span class="label">What I Do</span>
        <a href={`${base}services`} class="link-arrow">All Services →</a>
      </div>
      <div class="services-row">
        <div class="svc-item">
          <div class="svc-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="24" cy="24" r="20" stroke="currentColor" stroke-width="1.5"/>
              <line x1="14" y1="24" x2="34" y2="24" stroke="currentColor" stroke-width="1.5"/>
              <line x1="24" y1="14" x2="24" y2="34" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </div>
          <h3>Visual Identity</h3>
          <p>Brand systems that speak with coherence and quiet confidence.</p>
        </div>
        <div class="svc-item">
          <div class="svc-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="6" y="6" width="36" height="36" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="24" cy="24" r="10" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </div>
          <h3>Illustration</h3>
          <p>Original images that inhabit the space between thought and vision.</p>
        </div>
        <div class="svc-item">
          <div class="svc-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="8" y="4" width="32" height="40" rx="1" stroke="currentColor" stroke-width="1.5"/>
              <line x1="15" y1="16" x2="33" y2="16" stroke="currentColor" stroke-width="1.5"/>
              <line x1="15" y1="23" x2="33" y2="23" stroke="currentColor" stroke-width="1.5"/>
              <line x1="15" y1="30" x2="25" y2="30" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </div>
          <h3>Print & Editorial</h3>
          <p>Posters, books, and publications designed for the page.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Contact CTA ───────────────────────────────────────────────── -->
  <section class="section section-cta reveal">
    <div class="container">
      <div class="cta-inner">
        <span class="label">Let's Talk</span>
        <h2 class="cta-heading">Have a project in mind?</h2>
        <a href="mailto:bella@ladybcreatives.com" class="cta-email">
          bella@ladybcreatives.com
        </a>
        <a href={`${base}contact`} class="btn btn-dark">Get in Touch</a>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const trigger = document.getElementById('pop-trigger');
  const textEl = document.getElementById('pop-trigger-text');
  const root = document.documentElement;

  const NORMAL_HTML = 'wdym <em>"just make it pop"</em>?';
  const POP_HTML = 'OKAY TOO MUCH. <em>click to undo</em>';

  function burstConfetti() {
    const emojis = ['✦', '★', '💥', '🎉', '⚡', '🌈', '💫'];
    for (let i = 0; i < 28; i++) {
      const span = document.createElement('span');
      span.className = 'pop-confetti';
      span.textContent = emojis[Math.floor(Math.random() * emojis.length)];
      span.style.left = `${Math.random() * 100}vw`;
      span.style.animationDuration = `${1.6 + Math.random() * 1.2}s`;
      span.style.animationDelay = `${Math.random() * 0.4}s`;
      span.style.fontSize = `${1 + Math.random() * 1.5}rem`;
      document.body.appendChild(span);
      span.addEventListener('animationend', () => span.remove());
    }
  }

  trigger?.addEventListener('click', () => {
    const active = root.classList.toggle('pop-mode');
    trigger.setAttribute('aria-pressed', String(active));
    if (textEl) textEl.innerHTML = active ? POP_HTML : NORMAL_HTML;
    if (active) burstConfetti();
  });
</script>

<style>
  /* ─── Hero ───────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: var(--nav-height);
    min-height: clamp(560px, 90vh, 820px);
    display: flex;
    align-items: center;
    background-image: url('/kep_01.png');
    background-size: cover;
    background-position: right center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgba(15,13,12,0.62) 0%, rgba(15,13,12,0.25) 45%, transparent 68%);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: var(--max-width);
    width: 100%;
    margin: 0 auto;
    padding: 0 2.5rem;
  }

  .hero-label-pop {
    color: var(--pop-yellow);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .ransom-name {
    margin: 0.75rem 0 1.75rem;
  }

  .ransom-word {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.5rem;
  }

  .tile {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--cloud);
    color: var(--bg-dark);
    border: 2px solid var(--bg-dark);
    font-family: var(--font-ransom);
    font-weight: 400;
    font-size: clamp(2.2rem, 6vw, 4.6rem);
    line-height: 1;
    padding: 0.12em 0.22em 0.06em;
    transform: rotate(var(--r));
    box-shadow: 3px 3px 0 rgba(0,0,0,0.35);
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }

  .tile:hover {
    transform: rotate(calc(var(--r) * -1.4)) translateY(-5px) scale(1.06);
    box-shadow: 6px 7px 0 rgba(0,0,0,0.4);
    z-index: 2;
  }

  .tile:has(.tile-copy) { z-index: 1; }

  .tile-copy {
    position: absolute;
    z-index: 1;
    inset-block-start: -0.35em;
    inset-inline-end: -0.35em;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.7em;
    height: 1.7em;
    border-radius: 50%;
    background: var(--red);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.26em;
    font-weight: 600;
    box-shadow: 1px 1px 0 rgba(0,0,0,0.4);
  }

  .hero-tagline-pop {
    font-size: 1rem;
    color: var(--cloud);
    max-width: 38ch;
    line-height: 1.65;
    margin-bottom: 2.25rem;
    font-weight: 300;
  }

  .hero-actions-pop {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-pop-primary {
    background: var(--red);
    border-color: var(--red);
    border-radius: 999px;
    color: #fff;
  }
  .btn-pop-primary:hover {
    background: #A5311F;
    border-color: #A5311F;
  }

  .btn-pop-ghost {
    background: transparent;
    border-color: var(--cloud);
    border-radius: 999px;
    color: var(--cloud);
  }
  .btn-pop-ghost:hover {
    background: var(--cloud);
    color: var(--bg-dark);
  }

  /* Speech bubble */
  .speech-bubble {
    position: absolute;
    z-index: 2;
    inset-block-start: 16%;
    inset-inline-end: 6%;
    max-width: 230px;
    background: var(--cloud);
    border: none;
    border-radius: 18px;
    padding: 0.85rem 1.15rem;
    transform: rotate(-3deg);
    box-shadow: 3px 4px 0 rgba(0,0,0,0.4);
    cursor: pointer;
    text-align: start;
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }

  .speech-bubble:hover {
    transform: rotate(-3deg) scale(1.05);
    box-shadow: 4px 5px 0 rgba(0,0,0,0.4);
  }

  .speech-bubble::after {
    content: '';
    position: absolute;
    inset-block-end: -9px;
    inset-inline-start: 30px;
    width: 0;
    height: 0;
    border: 10px solid transparent;
    border-block-start-color: var(--cloud);
    border-block-end: 0;
  }

  .speech-bubble p {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--red);
  }

  /* ─── Info Strip ─────────────────────────────────────────────────── */
  .hero-strip {
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .strip-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.1rem;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text);
  }

  /* ─── Marquee ────────────────────────────────────────────────────── */
  .marquee {
    overflow: hidden;
    background: var(--bg-dark);
    border-block: 3px solid var(--bg-dark);
    padding-block: 1rem;
  }

  .marquee-track {
    display: flex;
    align-items: center;
    width: max-content;
    animation: marquee-scroll 70s linear infinite;
  }

  .marquee-word {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(1rem, 2.2vw, 1.4rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pop-yellow);
    white-space: nowrap;
    margin-inline-end: 1.5rem;
  }

  .marquee-star {
    color: var(--red);
    font-size: 1rem;
    margin-inline-end: 1.5rem;
  }

  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
  }

  /* ─── Latest Projects ────────────────────────────────────────────── */
  .latest-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .latest-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-sans);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .latest-bee {
    width: 2.6rem;
    height: auto;
    opacity: 0.85;
  }

  .latest-sub {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--red);
  }

  .latest-all { flex-shrink: 0; padding-bottom: 0.4rem; }

  .latest-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
  }

  .latest-card {
    display: block;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .latest-img-wrap {
    aspect-ratio: 4 / 3;
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.18);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }

  .latest-card:hover .latest-img-wrap {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(0,0,0,0.24);
  }

  .latest-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .latest-services { margin-bottom: 0.6rem; }

  .latest-name {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 400;
    margin-bottom: 0.75rem;
    transition: color 0.2s;
  }
  .latest-card:hover .latest-name { color: var(--red); }

  .latest-desc {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.65;
    max-width: 48ch;
    margin-bottom: 1.5rem;
  }

  .latest-btn { pointer-events: none; }

  /* ─── Services ───────────────────────────────────────────────────── */
  .services-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .svc-item { padding-top: 1.5rem; border-top: 3px solid var(--bg-dark); }

  .svc-icon {
    width: 48px;
    height: 48px;
    color: var(--red);
    margin-bottom: 1.25rem;
  }

  .svc-item h3 {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 400;
    margin-bottom: 0.6rem;
  }

  .svc-item p {
    font-size: 0.9rem;
    color: var(--text-muted);
    font-weight: 300;
  }

  /* ─── CTA ────────────────────────────────────────────────────────── */
  .section-cta { background: var(--bg-dark); color: var(--cloud); }
  .section-cta .label { color: var(--pop-yellow); margin-bottom: 1rem; }

  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
  }

  .cta-heading {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 300;
    color: var(--cloud);
  }

  .cta-email {
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 2.5vw, 1.8rem);
    font-weight: 300;
    color: var(--pop-yellow);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 0.2s;
  }
  .cta-email:hover { color: var(--red); }

  .section-cta .btn-dark {
    background: var(--red);
    border-color: var(--red);
    border-radius: 999px;
    color: #fff;
  }
  .section-cta .btn-dark:hover {
    background: #A5311F;
    border-color: #A5311F;
  }

  /* ─── Responsive ─────────────────────────────────────────────────── */
  @media (max-width: 960px) {
    .speech-bubble { display: none; }
    .latest-grid { grid-template-columns: 1fr; gap: 3rem; }
    .services-row { grid-template-columns: 1fr; gap: 2rem; }
  }

  @media (max-width: 768px) {
    .hero-content {
      padding: 0 1.25rem;
      text-align: center;
    }

    .hero-label-pop {
      font-size: 0.58rem;
      letter-spacing: 0.08em;
    }

    .ransom-word {
      flex-wrap: nowrap;
      justify-content: center;
      gap: 0.25rem;
    }

    .tile {
      font-size: clamp(1.3rem, 8.2vw, 2.4rem);
      padding: 0.1em 0.16em 0.04em;
      border-width: 1.5px;
    }

    .hero-tagline-pop {
      font-size: 0.88rem;
      line-height: 1.5;
      margin-bottom: 1.75rem;
      max-width: 32ch;
      margin-inline: auto;
    }

    .hero-actions-pop {
      justify-content: center;
    }

    .strip-inner { flex-direction: column; align-items: flex-start; }

    .latest-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }

  /* ═══════════════════════════════════════════════════════════════════
     EASTER EGG — "JUST MAKE IT POP" MODE
     Deliberately, gloriously too much. Click the speech bubble to toggle.
     ═══════════════════════════════════════════════════════════════════ */

  :global(html.pop-mode),
  :global(html.pop-mode body) {
    cursor: crosshair;
  }

  :global(html.pop-mode *) {
    font-family: 'Comic Sans MS', 'Comic Sans', var(--font-sans) !important;
  }

  :global(html.pop-mode body) {
    background: repeating-linear-gradient(
      45deg,
      #ff2fb0 0px, #ff2fb0 40px,
      #2fe6ff 40px, #2fe6ff 80px,
      #fff92f 80px, #fff92f 120px,
      #2fff6e 120px, #2fff6e 160px
    );
    background-size: 300% 300%;
    animation: pop-bg-shift 8s linear infinite;
  }

  @keyframes pop-bg-shift {
    0% { background-position: 0% 0%; }
    100% { background-position: 300% 300%; }
  }

  :global(html.pop-mode .header) {
    background: #ff2fb0 !important;
    border-bottom: 6px dashed #1c1c1c !important;
    animation: pop-shake 0.4s infinite;
  }

  @keyframes pop-shake {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(-0.6deg); }
    75% { transform: rotate(0.6deg); }
  }

  :global(html.pop-mode .nav-link) {
    color: #fff92f !important;
    text-shadow: 2px 2px 0 #ff2fb0, -2px -2px 0 #2fe6ff;
    font-weight: 900 !important;
  }

  :global(html.pop-mode .nav-cta) {
    border-color: #fff92f !important;
  }

  :global(html.pop-mode .hero) {
    animation: pop-hue 5s linear infinite;
  }

  @keyframes pop-hue {
    0%   { filter: saturate(2.6) contrast(1.3) hue-rotate(0deg); }
    100% { filter: saturate(2.6) contrast(1.3) hue-rotate(360deg); }
  }

  :global(html.pop-mode .tile) {
    background: #fff92f !important;
    border-color: #ff2fb0 !important;
    color: #ff2fb0 !important;
    box-shadow: 6px 6px 0 #2fe6ff !important;
    animation: pop-wiggle 0.5s ease-in-out infinite alternate;
  }

  @keyframes pop-wiggle {
    0%   { transform: rotate(var(--r)) scale(1); }
    100% { transform: rotate(calc(var(--r) * -2.2)) scale(1.15); }
  }

  :global(html.pop-mode .btn) {
    border-radius: 0 !important;
    border-width: 3px !important;
    box-shadow: 6px 6px 0 #1c1c1c !important;
    animation: pop-pulse 0.5s ease-in-out infinite alternate;
  }

  @keyframes pop-pulse {
    0%   { transform: scale(1) rotate(-1.5deg); }
    100% { transform: scale(1.07) rotate(1.5deg); }
  }

  :global(html.pop-mode h1),
  :global(html.pop-mode h2),
  :global(html.pop-mode h3) {
    color: #ff2fb0 !important;
    text-shadow: 3px 3px 0 #fff92f, -3px -3px 0 #2fe6ff !important;
    animation: pop-blink 1.1s steps(2) infinite;
  }

  @keyframes pop-blink {
    50% { opacity: 0.65; }
  }

  :global(html.pop-mode .label) {
    color: #2fe6ff !important;
    letter-spacing: 0.3em !important;
  }

  :global(html.pop-mode .latest-img-wrap) {
    border-radius: 0 !important;
    border: 6px solid #1c1c1c !important;
    transform: rotate(-2deg) !important;
    box-shadow: 10px 10px 0 #fff92f !important;
  }

  :global(html.pop-mode .latest-img) {
    filter: saturate(1.8) contrast(1.15);
  }

